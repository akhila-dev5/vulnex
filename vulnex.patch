@@ -0,0 +1,81 @@
+"""Pre-computed CVE inventory from the VulnerabilityData repository.
+
+`akhila-dev5/VulnerabilityData` scans the azurelinux-test ``cgmanifest.json``
+(every registered package name, version and tarball) against the NVD JSON 2.0
+feeds and publishes the result several times a day:
+
+  data/azurelinux-test.json   machine-readable per-package CVE inventory
+  oval/azurelinux-test.xml    OVAL 5.11.1 definitions (``linux:rpminfo`` tests)
+
+This source lets VULNEX read that feed over ``raw.githubusercontent.com``
+instead of re-running the multi-hundred-MB NVD scan locally. The feed is a
+*corroborating* inventory: the OSV/advisory pipeline remains the primary
+detection source, and this tells us what NVD's CPE data says about the exact
+versions registered in the manifest.
+
+Responses are cached on disk by :class:`~vulnex.http.CachedHTTP`, so repeated
+API calls are free and a transient upstream failure still serves the last
+known feed. Pass ``refresh=True`` to pick up a newly published scan.
+"""
+
+from __future__ import annotations
+
+from .. import config
+from ..http import CachedHTTP
+
+__all__ = ["VulnerabilityDataSource", "FeedError"]
+
+_FEED_KEY = "azurelinux-test.json"
+
+
+class FeedError(RuntimeError):
+    """Raised when the VulnerabilityData feed cannot be read."""
+
+
+class VulnerabilityDataSource:
+    """Read-only client for the published VulnerabilityData feed."""
+
+    name = "vulnerabilitydata"
+
+    def __init__(self, session=None, json_url: str | None = None,
+                 oval_url: str | None = None) -> None:
+        self.http = CachedHTTP(self.name, session)
+        self.json_url = json_url or config.VULNERABILITYDATA_JSON_URL
+        self.oval_url = oval_url or config.VULNERABILITYDATA_OVAL_URL
+
+    # -- feed access --------------------------------------------------------
+    def feed(self, refresh: bool = False) -> dict:
+        """The whole published document (cached; ``refresh`` re-fetches)."""
+        data = self.http.get_json(self.json_url, key=_FEED_KEY, force=refresh)
+        if not isinstance(data, dict) or not isinstance(data.get("packages"), list):
+            raise FeedError(
+                f"VulnerabilityData feed unavailable: {self.json_url}"
+            )
+        return data
+
+    def summary(self, refresh: bool = False) -> dict:
+        """Generator metadata, scan statistics and the OVAL document URL."""
+        data = self.feed(refresh)
+        source = data.get("source") or {}
+        return {
+            "distro": source.get("distro", "azurelinux-test"),
+            "generated_at": data.get("generated_at"),
+            "source": source,
+            "stats": data.get("stats") or {},
+            "json_url": self.json_url,
+            "oval_url": self.oval_url,
+        }
+
+    def packages(self, refresh: bool = False) -> list[dict]:
+        """Every package entry: name, versions, tarball and its CVE list."""
+        return self.feed(refresh).get("packages") or []
+
+    def package(self, name: str, refresh: bool = False) -> dict | None:
+        """One package's inventory by (case-insensitive) exact name."""
+        needle = (name or "").strip().lower()
+        if not needle:
+            return None
+        for pkg in self.packages(refresh):
+            if (pkg.get("name") or "").lower() == needle:
+                return pkg
+        return None

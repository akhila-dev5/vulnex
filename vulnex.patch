+"""Tests for the VulnerabilityData feed: source, API endpoints and CLI."""
+
+import json
+
+import pytest
+from fastapi.testclient import TestClient
+
+from vulnex import config
+from vulnex.api import app
+from vulnex.cli import main as cli_main
+from vulnex.sources.vulnerabilitydata import FeedError, VulnerabilityDataSource
+
+FEED = {
+    "schema_version": 1,
+    "generated_at": "2026-10-08T07:56:05Z",
+    "source": {
+        "manifest": "https://raw.githubusercontent.com/akhila-dev5/"
+                    "azurelinux-test/main/cgmanifest.json",
+        "distro": "azurelinux-test",
+        "nvd_feeds": "https://nvd.nist.gov/feeds/json/cve/2.0 (JSON 2.0)",
+        "scanner": "VulnerabilityData/scripts/scan.py",
+    },
+    "stats": {
+        "packages": 3176,
+        "packages_with_findings": 812,
+        "findings": 40211,
+        "by_match": {"cpe": 30211, "keyword": 10000},
+        "excluded_by_version": 5123,
+        "by_severity": {"HIGH": 9000, "MEDIUM": 20000, "LOW": 11211},
+        "scan_seconds": 51.2,
+    },
+    "packages": [
+        {
+            "name": "curl",
+            "versions": ["8.5.0"],
+            "tarball": "https://example.com/curl-8.5.0.tar.gz",
+            "cves": [
+                {
+                    "id": "CVE-2024-0001",
+                    "match": "cpe",
+                    "severity": "HIGH",
+                    "cvss_score": 9.1,
+                    "cvss_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
+                    "description": "A demo vulnerability",
+                    "ranges": [{"versionEndExcluding": "8.6.0"}],
+                    "affected_versions": ["8.5.0"],
+                }
+            ],
+        },
+        {"name": "openssl", "versions": ["3.0.7"], "tarball": "", "cves": []},
+    ],
+}
+
+
+@pytest.fixture()
+def feed(monkeypatch):
+    """Serve the fixture feed instead of hitting raw.githubusercontent.com."""
+    def _get_json(self, url, key, params=None, headers=None, force=False,
+                  timeout=None):
+        assert url == config.VULNERABILITYDATA_JSON_URL
+        return json.loads(json.dumps(FEED))
+
+    monkeypatch.setattr("vulnex.http.CachedHTTP.get_json", _get_json)
+    return FEED
+
+
+@pytest.fixture()
+def feed_down(monkeypatch):
+    """Upstream unavailable: CachedHTTP returns None."""
+    monkeypatch.setattr(
+        "vulnex.http.CachedHTTP.get_json",
+        lambda *a, **k: None,
+    )
+
+
+@pytest.fixture()
+def client():
+    return TestClient(app)
+
+
+# -- source ----------------------------------------------------------------
+def test_source_summary(feed):
+    summary = VulnerabilityDataSource().summary()
+    assert summary["distro"] == "azurelinux-test"
+    assert summary["generated_at"] == "2026-10-08T07:56:05Z"
+    assert summary["stats"]["packages"] == 3176
+    assert summary["json_url"].endswith("/data/azurelinux-test.json")
+    assert summary["oval_url"].endswith("/oval/azurelinux-test.xml")
+
+
+def test_source_package_lookup(feed):
+    source = VulnerabilityDataSource()
+    pkg = source.package("CURL")  # case-insensitive
+    assert pkg is not None
+    assert pkg["cves"][0]["id"] == "CVE-2024-0001"
+    assert source.package("nope") is None
+    assert source.package("") is None
+
+
+def test_source_feed_error(feed_down):
+    with pytest.raises(FeedError):
+        VulnerabilityDataSource().feed()
+
+
+def test_feed_urls_are_configurable():
+    assert "VulnerabilityData" in config.VULNERABILITYDATA_JSON_URL
+    meta = config.repository_metadata()
+    assert meta["vulnerability_data"] == config.VULNERABILITYDATA_JSON_URL
+    assert meta["vulnerability_data_oval"] == config.VULNERABILITYDATA_OVAL_URL
+
+
+# -- API -------------------------------------------------------------------
+def test_api_summary(client, feed):
+    resp = client.get("/api/vulnerability-data")
+    assert resp.status_code == 200, resp.text
+    data = resp.json()
+    assert data["generated_at"] == "2026-10-08T07:56:05Z"
+    assert data["stats"]["findings"] == 40211
+    assert data["oval_url"].endswith("azurelinux-test.xml")
+
+
+def test_api_packages_paging_and_search(client, feed):
+    resp = client.get("/api/vulnerability-data/packages")
+    assert resp.status_code == 200
+    data = resp.json()
+    assert data["total"] == 2
+    assert [p["name"] for p in data["items"]] == ["curl", "openssl"]
+
+    resp = client.get("/api/vulnerability-data/packages?search=CURL&limit=1")
+    data = resp.json()
+    assert data["total"] == 1
+    assert data["items"][0]["name"] == "curl"
+
+    resp = client.get("/api/vulnerability-data/packages?page=3&limit=1")
+    assert resp.json()["items"] == []
+
+
+def test_api_package_detail(client, feed):
+    resp = client.get("/api/vulnerability-data/packages/curl")
+    assert resp.status_code == 200
+    pkg = resp.json()
+    assert pkg["versions"] == ["8.5.0"]
+    assert pkg["cves"][0]["id"] == "CVE-2024-0001"
+    assert pkg["cves"][0]["ranges"] == [{"versionEndExcluding": "8.6.0"}]
+
+
+def test_api_package_unknown_404(client, feed):
+    resp = client.get("/api/vulnerability-data/packages/nope")
+    assert resp.status_code == 404
+
+
+def test_api_feed_unavailable_502(client, feed_down):
+    resp = client.get("/api/vulnerability-data")
+    assert resp.status_code == 502
+    resp = client.get("/api/vulnerability-data/packages")
+    assert resp.status_code == 502
+
+
+# -- CLI -------------------------------------------------------------------
+def test_cli_vuln_data_summary(capsys, feed):
+    assert cli_main(["vuln-data"]) == 0
+    out = json.loads(capsys.readouterr().out)
+    assert out["stats"]["packages_with_findings"] == 812
+    assert out["distro"] == "azurelinux-test"
+
+
+def test_cli_vuln_data_package(capsys, feed):
+    assert cli_main(["vuln-data", "--package", "openssl"]) == 0
+    pkg = json.loads(capsys.readouterr().out)
+    assert pkg["cves"] == []
+
+
+def test_cli_vuln_data_unknown_package(capsys, feed):
+    assert cli_main(["vuln-data", "--package", "nope"]) == 1
+    assert "not in the VulnerabilityData feed" in capsys.readouterr().err
+
+
+def test_cli_vuln_data_feed_down(capsys, feed_down):
+    assert cli_main(["vuln-data"]) == 1
+    assert "feed unavailable" in capsys.readouterr().err

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vulnex.Api</RootNamespace>
    <AssemblyName>Vulnex.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only third-party package: the PostgreSQL driver. Everything else
         (minimal APIs, JSON, CORS, compression) ships with ASP.NET Core. -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vulnex.Api.Tests" />
  </ItemGroup>

</Project>
